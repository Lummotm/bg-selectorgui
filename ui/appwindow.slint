export struct WallpaperData {
  name: string,
  image_path: image,
  }

export component AppWindow inherits Window {
  title: "bgselector";
  width: 1920px;
  height: 1080px;

  background: transparent;
  no-frame: true;

  in property <[WallpaperData]> wallpapers;
  in-out property <int> active-index: 0;

  callback wallpaper-selected(string);
  callback step-requested(int);        // -1 / +1
  callback close-requested();

  forward-focus: key-handler;

  key-handler := FocusScope {
    key-pressed(event) => {
      // Move back: Left arrow, "h" key, or Shift+Tab (Backtab)
      if (event.text == Key.LeftArrow || event.text == "h" || event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
        root.step-requested(-1);
        accept;
        } 
      // Move forward: Right arrow, "l" key, or Tab
      else if (event.text == Key.RightArrow || event.text == "l" || event.text == Key.Tab) {
        root.step-requested(1);
        accept;
        } 
      else if (event.text == Key.Return) {
        if (root.active-index >= 0 && root.active-index < root.wallpapers.length) {
          root.wallpaper-selected(root.wallpapers[root.active-index].name);
          root.close-requested();
          }
        accept;
        } 
      else if (event.text == Key.Escape) {
        root.close-requested();
        accept;
        } 
      else {
        reject;
        }
      }

    VerticalLayout {
      alignment: center;

      Rectangle {
        height: 700px;
        width: 100%;
        clip: true;

        HorizontalLayout {
          spacing: 0px; 

          x: (parent.width / 2) - 480px - (root.active-index * 180px);

          animate x {
          duration: 350ms;
          easing: ease-out;
          }

          for wp[i] in root.wallpapers : Rectangle {
            property <bool> is-active: i == root.active-index;
            width: is-active ? 960px : 180px;
            height: is-active ? 540px : 420px;

            y: (700px - self.height) / 2;
            animate width, height, y {
                duration: 200ms;
                easing: ease-out;
            }
            border-radius: 16px;
            clip: true;
            Image {
              source: wp.image_path;
              width: 100%;
              height: 100%;
              image-fit: cover;
              image-rendering: smooth;
              }
            TouchArea {
              clicked => {
                root.active-index = i;
                root.wallpaper-selected(wp.name);
                root.close-requested();
                }
              mouse-cursor: pointer;
              }
            }
          }
        }
      }
    }
  }
